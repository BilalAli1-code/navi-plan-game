# ProjectSim 2.0 — example environment variables.
# Copy to `.env.local` (developer) or `.env.test` (test) and fill in real values.
# Never commit populated secret files.

# --- Supabase (client-safe, exposed to apps/web via Vite) ---
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY=""
# Optional: override API base URL for the browser client (empty = same-origin / Vite proxy)
VITE_API_BASE_URL=""

# --- Supabase (server-side only, never exposed to the browser) ---
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_JWT_SECRET=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Durable API / Infrastructure database ---
# Used by @projectsim/api when PROJECTSIM_API_COMPOSITION=postgres
# and by Infrastructure Postgres integration tests.
DATABASE_URL="postgresql://projectsim_app:projectsim_app@127.0.0.1:5432/projectsim_test"
DATABASE_ADMIN_URL="postgresql://postgres:postgres@127.0.0.1:5432/projectsim_test"
# Legacy local Supabase DB URL alias (migrations / tooling).
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- @projectsim/api process (explicit; no silent repository fallback) ---
# Required: "postgres" (durable) or "memory" (explicit local/demo only)
PROJECTSIM_API_COMPOSITION="postgres"
# "supabase" (default with postgres) or "dev" (requires PROJECTSIM_ALLOW_DEV_AUTH=1)
PROJECTSIM_AUTH_MODE="supabase"
PROJECTSIM_ALLOW_DEV_AUTH="0"
PROJECTSIM_ENABLE_DEV_ROUTES="0"
# Opt-in PS-ROADMAP-008 E2E fixture/gate routes (forbidden when NODE_ENV=production)
PROJECTSIM_ENABLE_E2E_SEAMS="0"
# Required when E2E seams are enabled; sent as X-ProjectSim-E2E-Seam (server-side only)
PROJECTSIM_E2E_SEAM_SECRET=""
# Allows /api/v1/e2e/fixtures/cleanup { "global": true } — local/CI Playwright only
E2E_ALLOW_GLOBAL_RESET="0"
PROJECTSIM_SEED_DEMO="0"
PORT="8787"
# Playwright Decision lifecycle helpers (used by apps/web e2e)
E2E_API_BASE_URL="http://127.0.0.1:8787"
E2E_WEB_BASE_URL="http://127.0.0.1:4173"

# --- @projectsim/worker relay (PS-ROADMAP-023) ---
RELAY_ENABLED="1"
RELAY_POLL_INTERVAL_MS="1000"
RELAY_BATCH_SIZE="50"
RELAY_CONCURRENCY="4"
RELAY_CLAIM_LEASE_MS="60000"
RELAY_MAX_ATTEMPTS="5"
RELAY_RETRY_BASE_DELAY_MS="1000"
RELAY_RETRY_MAX_DELAY_MS="300000"
RELAY_RETRY_JITTER_RATIO="0.1"
RELAY_SHUTDOWN_TIMEOUT_MS="30000"
RELAY_HEALTH_PORT="8790"
# Optional diagnostic identity; auto-generated when unset
# RELAY_WORKER_ID="relay-local-1"
