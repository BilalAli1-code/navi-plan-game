{
  "name": "@projectsim/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "PROJECTSIM_API_COMPOSITION=memory PROJECTSIM_AUTH_MODE=dev PROJECTSIM_ALLOW_DEV_AUTH=1 PROJECTSIM_ENABLE_DEV_ROUTES=1 PROJECTSIM_SEED_DEMO=1 tsx watch src/server.ts",
    "dev:postgres": "PROJECTSIM_API_COMPOSITION=postgres PROJECTSIM_AUTH_MODE=supabase tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@projectsim/application": "workspace:*",
    "@projectsim/domain": "workspace:*",
    "@projectsim/infrastructure": "workspace:*",
    "hono": "^4.7.0",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.0"
  }
}
